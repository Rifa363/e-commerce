# Salin file ini menjadi ".env" lalu isi sesuai hosting Anda.
# Lokasi: sejajar dengan index.html (root project).

# ===== Database (shared hosting: ambil dari menu "Databases" di cPanel) =====
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ===== SMTP (opsional, untuk email reset password & notifikasi) =====
# Lihat docs/EMAIL_SETUP.md
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=RiRa Cakes
ADMIN_NOTIFICATION_EMAIL=

# ===== WhatsApp OTP / notifikasi (opsional) =====
# WHATSAPP_PROVIDER: wa_link | fonnte | wablas (sesuaikan gateway Anda)
WHATSAPP_PROVIDER=wa_link
WHATSAPP_API_TOKEN=
WHATSAPP_ADMIN_PHONE=6281219868390
